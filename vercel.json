{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/atendimento/:path*", "destination": "/api" },
    { "source": "/admin/:path*", "destination": "/api" },
    { "source": "/patrocinadores/:path*", "destination": "/api" },
    { "source": "/anuncios/:path*", "destination": "/api" },
    { "source": "/areas-ads/:path*", "destination": "/api" }
  ]
}
